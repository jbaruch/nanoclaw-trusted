# GitHub Actions secret — set in repo Settings → Secrets and variables → Actions,
# NOT copied into .env:
#   https://github.com/jbaruch/nanoclaw-trusted/settings/secrets/actions
# FLEET_DISPATCH_TOKEN — the token .github/workflows/review-trigger.yml reads to start the
#   review run in jbaruch/coding-policy. Create it with Actions: Read and write on
#   jbaruch/coding-policy.
FLEET_DISPATCH_TOKEN=

# CI reviewer secrets for the jbaruch/coding-policy gh-aw PR review workflows.
# These are GitHub Actions repository secrets — set them at:
# https://github.com/jbaruch/nanoclaw-trusted/settings/secrets/actions
#
# The OpenAI-family (Codex) reviewer accepts either CODEX_API_KEY or OPENAI_API_KEY
# (CODEX_API_KEY takes precedence).

# OpenAI / Codex reviewer credential
CODEX_API_KEY=replace-with-your-openai-or-codex-api-key
OPENAI_API_KEY=replace-with-your-openai-or-codex-api-key
# Anthropic (Claude) reviewer credential
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# Tessl registry token for the reviewer's `tessl install jbaruch/coding-policy` step
# Generate at https://tessl.io/account/api-keys
TESSL_TOKEN=replace-with-your-tessl-token
