{
  "schema_version": 1,
  "package_roots": [
    "skills/*",
    "rules"
  ],
  "package_change_lines": 400,
  "trust_boundary_paths": [
    ".github/workflows/*",
    "rules/container-trust-levels.md",
    "rules/installed-content-immutable.md",
    "rules/verification-protocol.md",
    "rules/github-data-via-gh.md",
    "rules/global-memory.md",
    "rules/ground-truth-trusted.md",
    "skills/google-ops/*",
    "skills/trusted-memory/*"
  ],
  "cli_spec_paths": [
    "skills/*/scripts/*.py"
  ],
  "cli_surface_markers": [
    "add_parser(",
    "add_argument(",
    "ArgumentParser("
  ],
  "user_doc_paths": [
    "README.md",
    "docs/*",
    "skills/*/SKILL.md"
  ]
}
